    "node-pty": "^1.2.0-beta.11",
    "node-screenshots": "^0.2.8",
    "puppeteer": "^24.37.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
