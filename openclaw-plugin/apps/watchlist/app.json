  "spec": {
    "toolFamily": "watchlist",
    "toolPrefix": "enso_watchlist_",
    "description": "Discover, track, and rate movies and TV series with a personal watchlist and AI-powered recommendations",
    "signatureId": "watchlist_view",
    "tools": [
      {
        "suffix": "browse",
        "description": "Browse your watchlist with filtering by status, genre, or rating",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "description": "Filter by status: all, to-watch, watching, completed (default: all)" },
            "sortBy": { "type": "string", "description": "Sort by: title, rating, dateAdded (default: dateAdded)" }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_watchlist_browse",
          "items": [
            { "id": "w1", "title": "Dune: Part Two", "year": 2024, "type": "movie", "genre": "Sci-Fi", "status": "completed", "rating": 5, "notes": "Visually stunning", "dateAdded": "2024-03-01", "posterDesc": "Desert landscape with a lone figure" },
            { "id": "w2", "title": "Shogun", "year": 2024, "type": "tv", "genre": "Drama", "status": "watching", "rating": 0, "notes": "", "dateAdded": "2024-02-20", "posterDesc": "Samurai era Japan" },
            { "id": "w3", "title": "The Bear", "year": 2022, "type": "tv", "genre": "Drama", "status": "to-watch", "rating": 0, "notes": "Recommended by friend", "dateAdded": "2024-02-15", "posterDesc": "Chef in a kitchen" }
          ],
          "stats": { "total": 3, "toWatch": 1, "watching": 1, "completed": 1, "avgRating": 5.0 }
        },
        "requiredDataKeys": ["tool", "items"],
        "isPrimary": true
      },
      {
        "suffix": "search",
        "description": "Search for movies and TV series by title to add to your watchlist",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": { "type": "string", "description": "Movie or TV series title to search for" }
          },
          "required": ["query"]
        },
        "sampleParams": { "query": "Oppenheimer" },
        "sampleData": {
          "tool": "enso_watchlist_search",
          "query": "Oppenheimer",
          "results": [
            { "title": "Oppenheimer", "year": 2023, "type": "movie", "genre": "Drama/History", "director": "Christopher Nolan", "synopsis": "The story of J. Robert Oppenheimer and the Manhattan Project", "rating": "8.4/10" }
          ]
        },
        "requiredDataKeys": ["tool", "query", "results"],
        "isPrimary": false
      },
      {
        "suffix": "add",
        "description": "Add a movie or TV series to your watchlist",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "description": "Title of the movie/series" },
            "year": { "type": "number", "description": "Release year" },
            "type": { "type": "string", "description": "movie or tv" },
            "genre": { "type": "string", "description": "Genre" },
            "status": { "type": "string", "description": "to-watch, watching, or completed (default: to-watch)" },
            "notes": { "type": "string", "description": "Personal notes" }
          },
          "required": ["title"]
        },
        "sampleParams": { "title": "Oppenheimer", "year": 2023, "type": "movie", "genre": "Drama", "status": "to-watch" },
        "sampleData": {
          "tool": "enso_watchlist_add",
          "success": true,
          "item": { "id": "w4", "title": "Oppenheimer", "year": 2023, "type": "movie", "genre": "Drama", "status": "to-watch", "rating": 0, "dateAdded": "2024-03-02" }
        },
        "requiredDataKeys": ["tool", "success"],
        "isPrimary": false
      },
      {
        "suffix": "update",
        "description": "Update a watchlist item's status, rating, or notes",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "itemId": { "type": "string", "description": "ID of the watchlist item" },
            "status": { "type": "string", "description": "New status: to-watch, watching, completed" },
            "rating": { "type": "number", "description": "Rating 1-5 (0 to clear)" },
            "notes": { "type": "string", "description": "Updated notes" }
          },
          "required": ["itemId"]
        },
        "sampleParams": { "itemId": "w1", "status": "completed", "rating": 5 },
        "sampleData": {
          "tool": "enso_watchlist_update",
          "success": true,
          "item": { "id": "w1", "title": "Dune: Part Two", "status": "completed", "rating": 5 }
        },
        "requiredDataKeys": ["tool", "success"],
        "isPrimary": false
      },
      {
        "suffix": "recommend",
        "description": "Get AI-powered movie/TV recommendations based on your watch history and ratings",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mood": { "type": "string", "description": "Optional mood or preference (e.g. 'something light', 'mind-bending sci-fi')" }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_watchlist_recommend",
          "recommendations": [
            { "title": "Arrival", "year": 2016, "type": "movie", "genre": "Sci-Fi/Drama", "reason": "You rated Dune 5 stars — this cerebral sci-fi shares similar themes", "rating": "7.9/10" },
            { "title": "Severance", "year": 2022, "type": "tv", "genre": "Sci-Fi/Thriller", "reason": "Based on your love of thought-provoking dramas", "rating": "8.7/10" }
          ]
        },
        "requiredDataKeys": ["tool", "recommendations"],
        "isPrimary": false
      },
      {
        "suffix": "remove",
        "description": "Remove an item from your watchlist",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "itemId": { "type": "string", "description": "ID of the item to remove" }
          },
          "required": ["itemId"]
        },
        "sampleParams": { "itemId": "w1" },
        "sampleData": {
          "tool": "enso_watchlist_remove",
          "success": true,
          "removedId": "w1"
        },
        "requiredDataKeys": ["tool", "success"],
        "isPrimary": false
      }
    ]
  }
}
