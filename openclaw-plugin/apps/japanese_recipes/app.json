          "tool": "enso_japanese_recipes_detail",
          "recipe": {
            "id": "tonkotsu_ramen",
            "name": "Tonkotsu Ramen",
            "category": "ramen",
            "cookTime": 480,
            "prepTime": 30,
            "servings": 4,
            "difficulty": "advanced",
            "description": "A rich, creamy pork bone broth ramen that simmers for hours to extract maximum flavor. Topped with tender chashu pork, a perfectly soft-boiled egg, and fresh toppings.",
            "image": "🍜",
            "ingredients": [
              { "item": "Pork bones (femur/neck)", "amount": "2 kg", "category": "broth" },
              { "item": "Water", "amount": "3 liters", "category": "broth" },
              { "item": "Garlic cloves", "amount": "6", "category": "broth" },
              { "item": "Ginger", "amount": "1 knob", "category": "broth" },
              { "item": "Fresh ramen noodles", "amount": "400g", "category": "noodles" },
              { "item": "Pork belly (for chashu)", "amount": "500g", "category": "toppings" },
              { "item": "Soy sauce", "amount": "100ml", "category": "toppings" },
              { "item": "Mirin", "amount": "50ml", "category": "toppings" },
              { "item": "Eggs", "amount": "4", "category": "toppings" },
              { "item": "Scallions", "amount": "4 stalks", "category": "garnish" },
              { "item": "Nori sheets", "amount": "4", "category": "garnish" }
            ],
            "steps": [
              "Blanch pork bones in boiling water for 10 minutes, then drain and rinse thoroughly.",
              "Place cleaned bones in a large pot with fresh water, garlic, and ginger. Bring to a rolling boil.",
              "Maintain a vigorous boil for 6-8 hours, adding water as needed. The broth should turn creamy white.",
              "While broth simmers, prepare chashu: roll pork belly, tie with string, and braise in soy sauce and mirin for 2 hours.",
              "Make soft-boiled eggs: boil for 6.5 minutes, ice bath, peel, and marinate in chashu braising liquid.",
              "Strain the broth and season with salt and soy sauce to taste.",
              "Cook ramen noodles according to package directions (usually 1-2 minutes).",
              "Assemble: noodles in bowl, ladle hot broth over, top with sliced chashu, halved egg, nori, and sliced scallions."
            ],
            "tips": [
              "The key to creamy broth is maintaining a rolling boil — not a simmer.",
              "Blanching bones first removes impurities for a cleaner-tasting broth.",
              "Chashu and eggs can be prepared a day ahead and stored in the braising liquid."
            ]
          }
        },
