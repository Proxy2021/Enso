      {
        "suffix": "track_nutrition",
        "description": "Show nutritional summary for planned meals with daily calorie and macro totals, weekly averages, and progress against customizable daily targets.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action: view or set_targets (default: view)"
            },
            "calorieTarget": {
              "type": "number",
              "description": "Daily calorie target (default: 2000)"
            },
            "proteinTarget": {
              "type": "number",
              "description": "Daily protein target in grams (default: 50)"
            },
            "carbsTarget": {
              "type": "number",
              "description": "Daily carbs target in grams (default: 250)"
            },
            "fatTarget": {
              "type": "number",
              "description": "Daily fat target in grams (default: 65)"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
