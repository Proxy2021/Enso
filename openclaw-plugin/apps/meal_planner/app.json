          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subtractPantry": {
              "type": "boolean",
              "description": "Whether to subtract pantry items from the list (default: true)"
            },
            "departments": {
              "type": "string",
              "description": "Comma-separated department categories to use (default: Produce,Dairy,Meat,Pantry,Frozen,Bakery,Beverages,Other)"
            }
          },
          "required": []
