  "spec": {
    "toolFamily": "meal_planner",
    "toolPrefix": "enso_meal_planner_",
    "description": "Comprehensive meal planning with weekly scheduling, shopping lists, nutrition tracking, pantry management, and meal suggestions",
    "signatureId": "meal_planner_view",
    "tools": [
      {
        "suffix": "plan_meals",
        "description": "Create and manage a weekly meal plan with configurable meal slots and serving sizes. Supports generating AI-powered plans, assigning recipes to slots, and removing meals.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action to perform: generate, assign, remove, or view (default: view)"
            },
            "day": {
              "type": "string",
              "description": "Day of the week (Monday-Sunday)"
            },
            "slot": {
              "type": "string",
              "description": "Meal slot: breakfast, lunch, dinner, or snacks"
            },
            "recipe": {
              "type": "string",
              "description": "Recipe name to assign to a slot"
            },
            "servings": {
              "type": "number",
              "description": "Number of servings per meal (default: 2)"
            },
            "diet": {
              "type": "string",
              "description": "Dietary preference for plan generation (e.g., balanced, vegetarian, keto, mediterranean)"
            },
            "mealSlots": {
              "type": "string",
              "description": "Comma-separated meal slots to include (default: breakfast,lunch,dinner,snacks)"
            }
          },
          "required": []
        },
        "sampleParams": {},
