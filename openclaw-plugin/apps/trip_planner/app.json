      {
        "suffix": "research",
        "description": "Research a destination with weather, costs, attractions, visa info, and travel tips",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destination": {
              "type": "string",
              "description": "Destination city or region to research"
            },
            "travelMonth": {
              "type": "string",
              "description": "Month or season of planned travel (e.g. 'July', 'winter')"
            },
            "interests": {
              "type": "string",
              "description": "Traveler interests for personalized tips (e.g. 'food, history, hiking')"
            }
          },
          "required": ["destination"]
        },
        "sampleParams": { "destination": "Tokyo, Japan" },
        "sampleData": {
          "tool": "enso_trip_planner_research",
          "destination": "Tokyo, Japan",
          "summary": "Tokyo is a vibrant metropolis blending ultra-modern technology with traditional temples. Known for world-class cuisine, efficient public transit, and unique cultural experiences.",
          "bestTimeToVisit": "Mar-May",
          "safetyRating": "Very Safe",
          "visaInfo": "Visa-free 90d",
          "weather": [
            { "month": "Jan", "avgTemp": 6, "rainfall": 52 },
            { "month": "Apr", "avgTemp": 15, "rainfall": 125 },
            { "month": "Jul", "avgTemp": 27, "rainfall": 154 },
            { "month": "Oct", "avgTemp": 18, "rainfall": 198 }
          ],
          "costs": {
            "budget_hotel": "$50-80/night",
            "mid_range_hotel": "$120-200/night",
            "meal_budget": "$8-15",
            "meal_mid_range": "$20-40",
            "public_transport_day": "$5-10",
            "attraction_avg": "$10-20"
          },
          "attractions": [
            { "name": "Senso-ji Temple", "category": "Temple", "rating": 4.7, "estimatedCost": "Free", "description": "Tokyo's oldest and most significant Buddhist temple" },
            { "name": "Tsukiji Outer Market", "category": "Food", "rating": 4.5, "estimatedCost": "$20-40", "description": "World-famous fish market with incredible street food" },
            { "name": "Shibuya Crossing", "category": "Landmark", "rating": 4.3, "estimatedCost": "Free", "description": "The world's busiest pedestrian crossing" }
          ],
          "tips": [
            "Get a Suica/Pasmo card for seamless public transport",
            "Many restaurants are cash-only — carry yen",
            "Convenience store food is surprisingly excellent and affordable",
            "Visit shrines early morning to avoid crowds"
          ]
        },
        "requiredDataKeys": ["tool", "destination"],
        "isPrimary": false
      },
      {
