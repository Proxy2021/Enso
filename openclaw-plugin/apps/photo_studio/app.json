            "filter": {
              "type": "string",
              "description": "Filter: all, image, video (default: image)"
            },
            "sortBy": {
              "type": "string",
              "description": "Sort: name, date, size (default: name)"
            },
            "sortDir": {
              "type": "string",
              "description": "Direction: asc, desc (default: asc)"
            }
          },
          "required": []
        },
        "sampleParams": {},
