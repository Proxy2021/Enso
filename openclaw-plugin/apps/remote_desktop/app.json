        "sampleParams": { "x": 500, "y": 300 },
        "sampleData": {
          "tool": "enso_remote_desktop_click",
          "screenshot": "/media/rdp-sample.jpg",
          "width": 1920,
          "height": 1080,
          "timestamp": 1709500001000
        },
        "requiredDataKeys": ["tool", "screenshot"],
        "isPrimary": false
      },
      {
