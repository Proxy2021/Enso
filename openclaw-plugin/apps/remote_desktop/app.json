    "description": "Remote desktop viewer with click, type, scroll, and keyboard control",
    "signatureId": "remote_desktop_view",
    "tools": [
      {
        "suffix": "capture",
        "description": "Capture a screenshot of the remote desktop",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monitor": {
              "type": "number",
              "description": "Monitor index (default 0 = primary)"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_remote_desktop_capture",
          "screenshot": "/media/rdp-sample.jpg",
          "width": 1920,
          "height": 1080,
          "timestamp": 1709500000000
        },
        "requiredDataKeys": ["tool", "screenshot", "width", "height"],
        "isPrimary": true
      },
      {
