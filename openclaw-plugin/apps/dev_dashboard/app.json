  "spec": {
    "toolFamily": "dev_dashboard",
    "toolPrefix": "enso_dev_",
    "description": "Developer command center for tracking projects, ideas, tasks, and dev notes across coding sessions",
    "signatureId": "dev_dashboard_view",
    "tools": [
      {
        "suffix": "overview",
        "description": "Show the developer dashboard with project list, recent tasks, and quick stats",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_dev_overview",
          "projects": [
            { "id": "p1", "name": "Enso", "path": "~/Desktop/Github/Enso", "branch": "main", "lastCommit": "Fix auth bypass", "status": "active" },
            { "id": "p2", "name": "AI Agent", "path": "~/projects/ai-agent", "branch": "feature/tools", "lastCommit": "Add tool registry", "status": "active" }
          ],
          "tasks": [
            { "id": "t1", "title": "Add streaming support", "project": "AI Agent", "status": "in-progress", "priority": "high", "createdAt": "2024-03-01" },
            { "id": "t2", "title": "Write unit tests", "project": "Enso", "status": "todo", "priority": "medium", "createdAt": "2024-02-28" }
          ],
          "stats": { "totalProjects": 2, "activeTasks": 3, "completedToday": 1, "totalNotes": 5 }
        },
        "requiredDataKeys": ["tool"],
        "isPrimary": true
      },
      {
        "suffix": "scan_repos",
        "description": "Scan a directory for git repositories and add them to the project tracker",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "description": "Directory to scan for git repos (default: ~/Desktop/Github)" }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_dev_scan_repos",
          "scannedPath": "~/Desktop/Github",
          "found": [
            { "name": "Enso", "path": "~/Desktop/Github/Enso", "branch": "main", "hasChanges": false }
          ],
          "totalFound": 1
        },
        "requiredDataKeys": ["tool", "found"],
        "isPrimary": false
      },
      {
        "suffix": "manage_task",
        "description": "Create, update, or delete a project task",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": { "type": "string", "description": "Action: create, update, delete" },
            "taskId": { "type": "string", "description": "Task ID for update/delete" },
            "title": { "type": "string", "description": "Task title (for create)" },
            "project": { "type": "string", "description": "Project name (for create)" },
            "status": { "type": "string", "description": "Status: idea, todo, in-progress, done" },
            "priority": { "type": "string", "description": "Priority: low, medium, high" },
            "notes": { "type": "string", "description": "Task notes" }
          },
          "required": ["action"]
        },
        "sampleParams": { "action": "create", "title": "Implement caching", "project": "AI Agent", "priority": "high" },
        "sampleData": {
          "tool": "enso_dev_manage_task",
          "action": "create",
          "success": true,
          "task": { "id": "t3", "title": "Implement caching", "project": "AI Agent", "status": "todo", "priority": "high", "createdAt": "2024-03-02" }
        },
        "requiredDataKeys": ["tool", "action", "success"],
        "isPrimary": false
      },
      {
        "suffix": "notebook",
        "description": "Manage dev notebook entries — save quick notes, code snippets, and links",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": { "type": "string", "description": "Action: view, add, delete" },
            "content": { "type": "string", "description": "Note content (for add)" },
            "tag": { "type": "string", "description": "Tag for categorization (e.g. 'snippet', 'idea', 'link', 'bug')" },
