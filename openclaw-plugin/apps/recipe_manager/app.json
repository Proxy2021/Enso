          "tool": "enso_recipe_manager_view_recipe",
          "title": "Creamy Tuscan Chicken Pasta",
          "description": "Sun-dried tomatoes, spinach, and parmesan in a creamy garlic sauce over penne.",
          "imageUrl": "https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=400&h=300&fit=crop",
          "prepTime": "15 min",
          "cookTime": "25 min",
          "totalTime": "40 min",
          "servings": 4,
          "difficulty": "Easy",
          "cuisine": ["Italian"],
          "dietary": [],
          "ingredients": [
            { "name": "boneless chicken breast", "amount": 1.5, "unit": "lbs" },
            { "name": "penne pasta", "amount": 12, "unit": "oz" },
            { "name": "sun-dried tomatoes", "amount": 0.5, "unit": "cup" },
            { "name": "fresh spinach", "amount": 3, "unit": "cups" },
            { "name": "heavy cream", "amount": 1, "unit": "cup" },
            { "name": "parmesan cheese", "amount": 0.5, "unit": "cup" },
            { "name": "garlic cloves, minced", "amount": 3, "unit": "" }
          ],
          "instructions": [
            "Cook penne according to package directions. Drain and set aside.",
            "Season chicken with salt and pepper. Cook in olive oil over medium-high heat 6-7 min per side. Slice into strips.",
            "In the same pan, sauté garlic 30 seconds. Add sun-dried tomatoes and cook 2 minutes.",
            "Pour in heavy cream and bring to a simmer. Stir in parmesan until melted.",
            "Add spinach and cook until wilted, about 2 minutes.",
            "Toss pasta and chicken into the sauce. Serve with extra parmesan."
          ],
          "tips": [
            "Use chicken thighs for extra juiciness.",
            "Add red pepper flakes for heat.",
            "Substitute half-and-half for a lighter version."
          ],
          "source": "web",
          "rating": 4.7
        },
