  "spec": {
    "toolFamily": "photo_culling_tool",
    "toolPrefix": "enso_photo_culling_tool_",
    "description": "AI-powered photo culling tool — scan shoot folders, auto-detect sharpest frames in bursts, flag blurry/eyes-closed shots, approve/reject with keyboard shortcuts, and export results",
    "signatureId": "photo_culling_tool_view",
    "tools": [
      {
        "suffix": "scan_folder",
        "description": "Scan a folder of photos for culling. Discovers images, extracts EXIF metadata, groups burst sequences by timestamp proximity, and creates a culling session. Use when the user says: 'cull my photos', 'scan shoot folder', 'open photo culling', 'analyze my shoot', 'find best shots', 'review a shoot'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "folderPath": {
              "type": "string",
              "description": "Path to the folder containing photos to scan"
            },
            "burstThresholdMs": {
              "type": "number",
              "description": "Milliseconds between shots to group as burst (default: 3000)"
            },
            "blurThreshold": {
              "type": "number",
              "description": "Sharpness score below which images are flagged blurry (default: 50)"
            },
            "skipFaces": {
              "type": "boolean",
              "description": "Skip face/eyes-closed detection (default: false)"
            },
            "rescan": {
              "type": "boolean",
              "description": "Force rescan even if a session already exists (default: false)"
            }
          },
          "required": ["folderPath"]
        },
        "sampleParams": { "folderPath": "C:/Users/Photos/Wedding" },
        "sampleData": {
          "tool": "enso_photo_culling_tool_scan_folder",
