      {
        "suffix": "analyze_folder",
        "description": "Full standalone photo analysis — scans a folder, extracts EXIF metadata, computes sharpness scores via Laplacian variance, detects faces and eye-open/closed status, groups burst sequences by timestamp clustering with filename fallback, ranks images, and returns structured JSON with bursts and unclustered arrays. Use when: 'analyze this shoot folder', 'find the best shots', 'which photos are sharpest', 'group my burst shots'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "folderPath": {
              "type": "string",
              "description": "Absolute path to the folder containing photos to analyze"
            },
            "burstThresholdMs": {
              "type": "number",
              "description": "Max ms between shots to group as burst (default: 3000)"
            },
            "blurThreshold": {
              "type": "number",
              "description": "Sharpness score below which images are flagged blurry (default: 50)"
            },
            "earThreshold": {
              "type": "number",
              "description": "Eye aspect ratio below which eyes are flagged closed (default: 0.2)"
            },
            "skipFaces": {
              "type": "boolean",
              "description": "Skip face/eyes-closed detection for faster processing (default: false)"
            },
            "maxSharpnessSize": {
              "type": "number",
              "description": "Max pixel dimension for sharpness analysis resize (default: 1024)"
            },
            "maxFaceSize": {
              "type": "number",
              "description": "Max pixel dimension for face detection resize (default: 640)"
            }
