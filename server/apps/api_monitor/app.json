{
  "version": 1,
  "createdAt": 1711100000000,
  "spec": {
    "toolFamily": "api_monitor",
    "toolPrefix": "enso_api_monitor_",
    "description": "Real-time API monitoring dashboard with endpoint health, latency tracking, alerting, incident management, and webhook integrations",
    "signatureId": "api_monitor_overview",
    "tools": [
      {
        "suffix": "overview",
        "description": "Show the API health dashboard with system status, stat cards, active alerts, and endpoint summary. Use when the user says: 'show API dashboard', 'API status', 'system health', 'monitoring overview'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeRange": {
              "type": "string",
              "description": "Time range for metrics: 1h, 24h, 7d, 30d (default: 24h)"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_api_monitor_overview",
          "title": "API Health Dashboard",
          "lastUpdated": "2026-03-22T14:35:00Z",
          "systemStatus": "degraded",
          "statCards": [
            { "key": "endpoints", "label": "Endpoints Monitored", "value": 8, "format": "number", "status": "healthy", "sparkline": [8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8] },
            { "key": "uptime", "label": "Overall Uptime", "value": 99.94, "format": "percent", "change": -0.03, "changeLabel": "vs yesterday", "status": "healthy", "sparkline": [99.99, 99.98, 99.97, 99.95, 99.94, 99.90, 99.85, 99.88, 99.92, 99.94, 99.94, 99.94] },
            { "key": "alerts", "label": "Active Alerts", "value": 3, "format": "number", "change": 2, "changeLabel": "vs yesterday", "status": "warning", "sparkline": [0, 0, 1, 1, 0, 0, 0, 1, 2, 3, 3, 3] },
            { "key": "latency", "label": "Avg Latency", "value": 142, "unit": "ms", "format": "number", "change": -12, "changeLabel": "vs yesterday", "status": "healthy", "sparkline": [165, 158, 152, 148, 145, 142, 138, 140, 155, 160, 148, 142] }
          ],
          "activeAlerts": [
            { "id": "alert-001", "severity": "critical", "title": "High 5xx Error Rate", "endpoint": "/api/v1/orders", "method": "POST", "value": "8.7%", "threshold": "5%", "duration": "12 min" }
          ],
          "endpoints": [
            { "id": "ep-1", "path": "/api/v1/users", "method": "GET", "status": "healthy", "rps": 450, "latency_p50": 45, "errorRate": 0.1, "uptime": 99.99, "sparkline": [42, 44, 46, 43, 45, 48, 50, 47, 44, 42, 45, 45] }
          ]
        },
        "requiredDataKeys": ["tool", "systemStatus", "endpoints"],
        "isPrimary": true
      },
      {
        "suffix": "endpoint_detail",
        "description": "View detailed metrics for a specific API endpoint including latency percentiles, throughput, error breakdown, and time-series data. Use when the user says: 'show endpoint details', 'drill into /api/users', 'endpoint metrics'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpointId": {
              "type": "string",
              "description": "Endpoint ID to view details for"
            },
            "timeRange": {
              "type": "string",
              "description": "Time range: 1h, 24h, 7d, 30d (default: 24h)"
            }
          },
          "required": ["endpointId"]
        },
        "sampleParams": { "endpointId": "ep-3" },
        "sampleData": {
          "tool": "enso_api_monitor_endpoint_detail",
          "endpoint": {
            "id": "ep-3", "path": "/api/v1/orders", "method": "POST", "status": "critical",
            "uptime": 99.12, "rps": 95, "latency_p50": 120, "latency_p95": 340, "latency_p99": 890, "errorRate": 8.7
          },
          "latencyTimeSeries": [
            { "time": "00:00", "p50": 82, "p95": 210, "p99": 420 },
            { "time": "06:00", "p50": 80, "p95": 200, "p99": 390 },
            { "time": "12:00", "p50": 110, "p95": 280, "p99": 580 },
            { "time": "14:00", "p50": 120, "p95": 340, "p99": 890 }
          ],
          "statusCodeBreakdown": [
            { "code": "2xx", "count": 18420, "percentage": 89.8 },
            { "code": "4xx", "count": 310, "percentage": 1.5 },
            { "code": "5xx", "count": 1785, "percentage": 8.7 }
          ]
        },
        "requiredDataKeys": ["tool", "endpoint"],
        "isPrimary": false
      },
      {
        "suffix": "alerts",
        "description": "View active alerts, resolved alerts, and alert rule configurations. Use when the user says: 'show alerts', 'alert rules', 'what alerts are firing', 'alert history'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tab": {
              "type": "string",
              "description": "Tab to show: active, resolved, or rules (default: active)"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_api_monitor_alerts",
          "summary": { "firing": 2, "warning": 1, "resolved_24h": 5, "total_rules": 8 },
          "activeAlerts": [
            { "id": "alert-001", "severity": "critical", "title": "High 5xx Error Rate", "endpoint": "/api/v1/orders", "method": "POST", "value": "8.7%", "threshold": "5%", "duration": "12 min", "channels": ["slack-ops", "pagerduty-primary"] }
          ],
          "rules": [
            { "id": "rule-1", "name": "High 5xx Error Rate", "metric": "error_rate_5xx", "condition": ">", "threshold": 5.0, "unit": "%", "severity": "critical", "enabled": true }
          ]
        },
        "requiredDataKeys": ["tool"],
        "isPrimary": false
      },
      {
        "suffix": "webhooks",
        "description": "View and manage webhook configurations, delivery logs, and payload examples. Use when the user says: 'show webhooks', 'webhook status', 'webhook config', 'delivery log'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action: list, create, edit, test, delete (default: list)"
            },
            "webhookId": {
              "type": "string",
              "description": "Webhook ID for edit/test/delete actions"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_api_monitor_webhooks",
          "webhooks": [
            { "id": "wh-1", "name": "Slack \u2014 #api-alerts", "type": "slack", "events": ["alert.firing", "alert.resolved"], "enabled": true, "successRate": 97.9, "delivered": 142, "total": 145 }
          ],
          "webhookPayloadExample": { "event_type": "alert.firing", "alert": { "id": "alert-001", "severity": "critical" } }
        },
        "requiredDataKeys": ["tool", "webhooks"],
        "isPrimary": false
      },
      {
        "suffix": "history",
        "description": "View historical charts for latency, throughput, and error rates with selectable time ranges. Use when the user says: 'show history', 'latency trends', '7-day metrics', 'historical data'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeRange": {
              "type": "string",
              "description": "Time range: 1h, 6h, 24h, 7d, 30d (default: 24h)"
            },
            "metric": {
              "type": "string",
              "description": "Metric to chart: latency, errors, throughput, all (default: all)"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_api_monitor_history",
          "timeRange": "24h",
          "latencyChart": [
            { "time": "Mar 22 00:00", "p50": 52, "p95": 135, "p99": 260 },
            { "time": "Mar 22 06:00", "p50": 52, "p95": 135, "p99": 260 },
            { "time": "Mar 22 12:00", "p50": 115, "p95": 290, "p99": 600 },
            { "time": "Mar 22 14:00", "p50": 120, "p95": 310, "p99": 680 }
          ],
          "errorRateChart": [
            { "time": "Mar 22 00:00", "total": 0.0 },
            { "time": "Mar 22 14:00", "total": 1.76 }
          ],
          "incidents": [
            { "id": "inc-101", "title": "Database connection pool exhausted", "severity": "critical", "status": "resolved", "duration": "27 min" }
          ]
        },
        "requiredDataKeys": ["tool"],
        "isPrimary": false
      },
      {
        "suffix": "incidents",
        "description": "View incident timeline, manage incidents (acknowledge, resolve), and view postmortem details. Use when the user says: 'show incidents', 'incident log', 'active incidents', 'acknowledge incident'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action: list, view, acknowledge, resolve (default: list)"
            },
            "incidentId": {
              "type": "string",
              "description": "Incident ID for view/acknowledge/resolve actions"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_api_monitor_incidents",
          "summary": { "active": 1, "resolved_7d": 4, "mttr_hours": 0.52, "total_30d": 8 },
          "incidents": [
            { "id": "inc-100", "title": "High error rate on order processing", "severity": "critical", "status": "investigating", "startedAt": "2026-03-22T14:23:00Z", "duration": "12 min (ongoing)", "affected": "/api/v1/orders POST" }
          ]
        },
        "requiredDataKeys": ["tool", "incidents"],
        "isPrimary": false
      },
      {
        "suffix": "export",
        "description": "Export API monitoring data as text or CSV format. Use when the user says: 'export metrics', 'download report', 'export API data', 'generate report'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string",
              "description": "Export format: text or csv (default: text)"
            },
            "timeRange": {
              "type": "string",
              "description": "Time range for export: 1h, 24h, 7d, 30d (default: 24h)"
            },
            "endpointId": {
              "type": "string",
              "description": "Optional endpoint ID to export specific endpoint data"
            }
          },
          "required": []
        },
        "sampleParams": { "format": "text" },
        "sampleData": {
          "tool": "enso_api_monitor_export",
          "format": "text",
          "timeRange": "24h",
          "endpointCount": 8,
          "summary": "API Monitor Export — 24h\n═══════════════════\nGET /api/v1/users [HEALTHY]\n  Throughput: 450 req/s\n  Latency: p50=45ms p95=120ms\n  Error Rate: 0.1%\n  Uptime: 99.99%"
        },
        "requiredDataKeys": ["tool", "summary"],
        "isPrimary": false
      }
    ]
  }
}
