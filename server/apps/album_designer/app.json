  "spec": {
    "toolFamily": "album_designer",
    "toolPrefix": "enso_album_designer_",
    "description": "Photo book project planner — manage multiple album projects from concept to print. Multi-printer support (Printique, Saal Digital, WhiteWall), 5-pass curation with daily goals, chapter-based sequence building, narrative arc visualization, and print-ready checklists.",
    "signatureId": "album_designer_view",
    "tools": [
      {
        "suffix": "setup_project",
        "description": "Create or load an album project with title, recipient, theme, format specs, printer choice, due date, and occasion. Use when the user says: 'start album project', 'create a photo book', 'design a gift album', 'plan my photo album'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action: create, load, update, list, delete"
            },
            "projectId": {
              "type": "string",
              "description": "Project ID for load/update/delete (omit for create/list)"
            },
            "title": {
              "type": "string",
              "description": "Album title"
            },
            "recipient": {
              "type": "string",
              "description": "Who is this gift for?"
            },
            "theme": {
              "type": "string",
              "description": "Trip or theme name"
            },
            "targetSpreads": {
              "type": "number",
              "description": "Target number of spreads (default: 35)"
            },
            "targetImages": {
              "type": "number",
              "description": "Target total images (default: 60)"
            },
            "totalCandidates": {
              "type": "number",
              "description": "Total candidate photos to cull from (e.g. 2400 for a single trip)"
            },
            "printer": {
              "type": "string",
              "description": "Print service: printique, saal_digital, whitewall (default: saal_digital)"
            },
            "dueDate": {
              "type": "string",
              "description": "Target completion date (ISO format, e.g. 2026-06-15)"
            },
            "occasion": {
              "type": "string",
              "description": "Occasion or reason (e.g. Mom's birthday, Anniversary gift)"
            },
            "status": {
              "type": "string",
              "description": "Project status: planning, culling, selecting, sequencing, layout, printing, done"
            }
          },
          "required": ["action"]
        },
        "sampleParams": { "action": "create", "title": "Summer in Kyoto", "recipient": "Mom", "theme": "Japan 2025", "printer": "saal_digital", "dueDate": "2026-06-15", "occasion": "Mom's birthday" },
