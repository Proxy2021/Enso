      {
        "suffix": "sequence_builder",
        "description": "Plan the album's narrative flow at chapter level — add, edit, remove, or reorder chapters/sections with spread counts, pacing notes, and variety reminders. Use when the user says: 'plan album chapters', 'sequence my album', 'plan the narrative', 'organize album sections'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectId": {
              "type": "string",
              "description": "Project ID"
            },
            "action": {
              "type": "string",
              "description": "Action: add, update, remove, reorder, list"
            },
            "chapterIndex": {
              "type": "number",
              "description": "Chapter index (0-based) for update/remove"
            },
            "name": {
              "type": "string",
              "description": "Chapter name (e.g. 'Arrival', 'The Old City')"
            },
            "spreadCount": {
              "type": "number",
              "description": "Number of spreads allocated to this chapter"
            },
            "pacingNotes": {
              "type": "string",
              "description": "Pacing notes (e.g. 'mix wide + detail, slow pace')"
            },
            "varietyTags": {
              "type": "string",
              "description": "Comma-separated variety tags: wide, detail, portrait, food, street, aerial"
            },
            "moveFrom": {
              "type": "number",
              "description": "Source index for reorder"
            },
            "moveTo": {
              "type": "number",
              "description": "Destination index for reorder"
            }
          },
          "required": ["projectId", "action"]
