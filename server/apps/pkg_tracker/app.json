            { "id": "jellyfin", "name": "Jellyfin", "status": "disconnected", "lastSync": null, "recordCount": 0, "health": "unknown" },
            { "id": "playnite", "name": "Playnite", "status": "disconnected", "lastSync": null, "recordCount": 0, "health": "unknown" },
            { "id": "obsidian", "name": "Obsidian", "status": "disconnected", "lastSync": null, "recordCount": 0, "health": "unknown" }
          ],
          "checkedAt": "2026-04-14T10:30:00Z"
        },
        "requiredDataKeys": ["tool", "sources"],
        "isPrimary": false
      },
      {
        "suffix": "graph_stats",
        "description": "Get knowledge graph statistics including node counts by type, relationship counts, and most connected entities. Returns placeholder data until Neo4j is deployed. Use when: 'graph stats', 'knowledge graph overview', 'show graph metrics'.",
