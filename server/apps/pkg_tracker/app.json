          "tool": "enso_pkg_tracker_check_connections",
          "sources": [
            { "id": "enso_cortex", "name": "Enso Cortex", "status": "connected", "lastSync": "2026-04-14T10:00:00Z", "recordCount": 342, "health": "healthy" },
            { "id": "kindle_readwise", "name": "Kindle / Readwise", "status": "disconnected", "lastSync": null, "recordCount": 0, "health": "unknown" },
