      {
        "suffix": "run_action",
        "description": "Execute a quick action: full_sync, reset_tracker, export_status, or add_custom_tool. Use when: 'run full sync', 'reset tracker', 'export status', 'add custom tool'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action to run: full_sync, reset_tracker, export_status, add_custom_tool"
            },
            "phaseId": {
              "type": "string",
              "description": "Phase ID for add_custom_tool action"
            },
            "toolName": {
              "type": "string",
              "description": "Tool name for add_custom_tool action"
            },
            "checklistItems": {
              "type": "string",
              "description": "Comma-separated checklist items for add_custom_tool"
            }
          },
          "required": ["action"]
        },
        "sampleParams": { "action": "full_sync" },
        "sampleData": {
          "tool": "enso_pkg_tracker_run_action",
          "action": "full_sync",
          "result": "Sync initiated across all connected sources",
          "syncResults": [
