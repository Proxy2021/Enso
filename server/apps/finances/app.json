{
  "version": 1,
  "createdAt": 1713600000000,
  "spec": {
    "toolFamily": "finances",
    "toolPrefix": "enso_finances_",
    "description": "Financial accounts dashboard — unified view across brokerage and private-bank accounts with wealth monitoring, refresh logs, and notification settings. Each account is a Cortex entity; each periodic statement is its own synthesis page. Privacy: all data lives at ~/.enso/wiki/ and ~/.enso/data/finances/ (local only — never committed to git).",
    "signatureId": "finances_dashboard",
    "tools": [
      {
        "suffix": "list_accounts",
        "description": "List all known financial accounts with current balance, account type, and holdings count. Reads ~/.enso/data/finances/accounts.json (the local index built by the refresh executors). Use when the user says 'show my accounts', 'financial dashboard', 'net worth', 'wealth overview'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_finances_list_accounts",
          "totalAccounts": 2,
          "totalValueByCurrency": {"USD": 1234567},
          "lastRefreshAt": "2026-04-19T12:00:00Z",
          "accounts": [
            {"accountId": "FAKE_ACCT_A", "displayName": "FAKE Brokerage A", "institution": "FAKE_INSTITUTION", "accountType": "brokerage", "baseCurrency": "USD", "currentValue": 0, "holdingsCount": 0, "statementCount": 0, "lastUpdated": "2026-04-19T12:00:00Z"}
          ]
        },
        "requiredDataKeys": ["tool", "accounts"],
        "isPrimary": true
      },
      {
        "suffix": "account_detail",
        "description": "Show full detail for one financial account: holdings, recent activity, statements list. Use when user clicks an account row or says 'show <account>'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accountId": {"type": "string", "description": "Stable account identifier"}
          },
          "required": ["accountId"]
        },
        "sampleParams": {"accountId": "FAKE_ACCT_A"},
        "sampleData": {
          "tool": "enso_finances_account_detail",
          "accountId": "FAKE_ACCT_A",
          "displayName": "FAKE Brokerage A",
          "institution": "FAKE_INSTITUTION",
          "accountType": "brokerage",
          "baseCurrency": "USD",
          "currentValue": 0,
          "holdings": [],
          "statements": [],
          "recentActivity": []
        },
        "requiredDataKeys": ["tool", "accountId"],
        "isPrimary": false
      },
      {
        "suffix": "statement_detail",
        "description": "Show one periodic statement (snapshot) for an account. Renders opening/closing value, net change, holdings, transactions, fees.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statementId": {"type": "string"}
          },
          "required": ["statementId"]
        },
        "sampleParams": {"statementId": "FAKE_STATEMENT"},
        "sampleData": {
          "tool": "enso_finances_statement_detail",
          "statementId": "FAKE_STATEMENT",
          "accountId": "FAKE_ACCT_A",
          "period": "2026-04",
          "openingValue": 0,
          "closingValue": 0,
          "netChange": 0,
          "holdings": [],
          "transactions": []
        },
        "requiredDataKeys": ["tool", "statementId"],
        "isPrimary": false
      },
      {
        "suffix": "refresh_kk_live",
        "description": "Re-read the local FactorStrategies accounts directory (data/development/accounts/*.json) and rewrite the financial-account entity pages + per-rebalance statement pages in the Cortex. Use when user says 'refresh accounts', 'update KK_Live', or after a new rebalance.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accountsDir": {"type": "string", "description": "Override the default FactorStrategies accounts dir."}
          }
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_finances_refresh_kk_live",
          "success": true,
          "accountsScanned": 1,
          "statementsWritten": 1,
          "message": "Refreshed 1 account, wrote 1 statement page"
        },
        "requiredDataKeys": ["tool", "success"],
        "isPrimary": false
      },
      {
        "suffix": "configure_bank",
        "description": "Add, update, or remove a bank entry in the local config at ~/.enso/data/finances/banks.json. Each entry binds a sender email + subject pattern to a bank id used by refresh_rm_emails. The shipped repo has NO seed entries — config is per-user, local-only, never committed.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "description": "Short bank slug (e.g. 'gtjas', 'citi-pb')."},
            "displayName": {"type": "string", "description": "Human-readable bank name."},
            "senderEmail": {"type": "string", "description": "Substring or full sender email (e.g. RM address)."},
            "subjectMatch": {"type": "string", "description": "Substring (case-insensitive) the email subject must contain."},
            "accountType": {"type": "string", "description": "'brokerage' or 'private-bank'. Default 'brokerage'."},
            "baseCurrency": {"type": "string", "description": "Default currency. Default 'USD'."},
            "remove": {"type": "boolean", "description": "If true, remove the entry with this id."}
          },
          "required": ["id"]
        },
        "sampleParams": {"id": "fake-bank-id", "displayName": "Fake Bank", "senderEmail": "fake@example.com", "subjectMatch": "Fake Pattern"},
        "sampleData": {
          "tool": "enso_finances_configure_bank",
          "success": true,
          "action": "added",
          "bank": {"id": "fake-bank-id"},
          "bankCount": 0
        },
        "requiredDataKeys": ["tool", "success"],
        "isPrimary": false
      },
      {
        "suffix": "refresh_rm_emails",
        "description": "For each configured bank in ~/.enso/data/finances/banks.json, fetch matching RM performance emails via Outlook COM, LLM-extract structured statement data, and persist as financial-account entity + financial-statement synthesis pages. Use when user says 'refresh RM statements', 'pull bank emails', or after a new RM email arrives.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bankId": {"type": "string", "description": "Optional: only refresh this bank id."},
            "limit": {"type": "number", "description": "Max emails per bank to process (default 6, max 20)."},
            "force": {"type": "boolean", "description": "If true, re-extract emails even if cached."}
          }
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_finances_refresh_rm_emails",
          "success": true,
          "banksProcessed": 0,
          "totalScanned": 0,
          "totalMatched": 0,
          "totalExtracted": 0,
          "bankResults": [],
          "message": "Processed 0 banks (no entries in config)."
        },
        "requiredDataKeys": ["tool", "success"],
        "isPrimary": false
      },
      {
        "suffix": "wealth_status",
        "description": "Wealth monitoring dashboard: shows all accounts with staleness indicators, active alerts (daily swings, milestone crossings, concentration risk, refresh failures), refresh schedule status, and net worth sparkline. Use when user says 'wealth status', 'account health', 'wealth dashboard', 'monitoring dashboard'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_finances_wealth_status",
          "totalAccounts": 2,
          "primaryCurrency": "USD",
          "primaryTotal": 1234567,
          "delta": 5000,
          "deltaPct": 0.4,
          "deltaPeriod": "2026-05-04",
          "accounts": [{"accountId": "A1", "displayName": "Sample", "severity": "ok", "currentValue": 1234567, "daysSinceUpdate": 1.2}],
          "alerts": [],
          "refreshStatus": {"kkLive": {"enabled": true, "lastRefresh": null}, "rmEmails": {"enabled": true, "lastRefresh": null}},
          "recentRefreshes": [],
          "sparkline": [],
          "config": {"staleness": {"warnDays": 7}, "thresholds": {"dailyChangePct": 3.0}, "channels": {"email": true}}
        },
        "requiredDataKeys": ["tool", "accounts"],
        "isPrimary": false
      },
      {
        "suffix": "refresh_log",
        "description": "Show history of all wealth data refreshes with success/failure status, duration, accounts updated, and net worth deltas. Use when user says 'refresh history', 'refresh log', 'what refreshes ran'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {"type": "number", "description": "Max entries to return (default 50, max 200)."},
            "source": {"type": "string", "description": "Filter by source: 'kk-live' or 'rm-emails'."}
          }
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_finances_refresh_log",
          "totalRefreshes": 10,
          "successCount": 8,
          "failureCount": 2,
          "successRate": 80,
          "avgDurationMs": 5000,
          "last7Days": {"total": 5, "success": 4, "failures": 1},
          "entries": [{"ts": "2026-05-05T08:00:00Z", "source": "kk-live", "success": true, "duration": 3200, "accountsUpdated": 1, "trigger": "scheduled"}]
        },
        "requiredDataKeys": ["tool", "entries"],
        "isPrimary": false
      },
      {
        "suffix": "wealth_config",
        "description": "View or update wealth monitoring settings: refresh schedule (KK Live, RM emails), staleness thresholds, alert thresholds (daily change %, concentration), and notification channels (email, WeChat, in-app). Use when user says 'wealth settings', 'configure monitoring', 'notification settings'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {"type": "string", "description": "'view' (default) or 'update' to save changes."},
            "kkLiveEnabled": {"type": "boolean", "description": "Enable/disable KK Live auto-refresh."},
            "kkLiveCron": {"type": "string", "description": "Cron for KK Live refresh."},
            "rmEmailsEnabled": {"type": "boolean", "description": "Enable/disable RM emails auto-refresh."},
            "rmEmailsCron": {"type": "string", "description": "Cron for RM emails refresh."},
            "warnDays": {"type": "number", "description": "Days before staleness warning."},
            "alertDays": {"type": "number", "description": "Days before staleness alert."},
            "criticalDays": {"type": "number", "description": "Days before critical staleness."},
            "dailyChangePct": {"type": "number", "description": "Daily swing alert threshold (%)."},
            "concentrationPct": {"type": "number", "description": "Single-position concentration threshold (%)."},
            "emailEnabled": {"type": "boolean", "description": "Enable email notifications."},
            "wechatEnabled": {"type": "boolean", "description": "Enable WeChat notifications."},
            "inAppEnabled": {"type": "boolean", "description": "Enable in-app notifications."}
          }
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_finances_wealth_config",
          "action": "view",
          "updated": false,
          "config": {
            "refreshSchedule": {"kkLive": {"enabled": true, "cron": "0 8 * * 1-5"}, "rmEmails": {"enabled": true, "cron": "0 9 * * 1"}},
            "staleness": {"warnDays": 7, "alertDays": 14, "criticalDays": 30},
            "thresholds": {"dailyChangePct": 3.0, "concentrationPct": 25},
            "channels": {"email": true, "wechat": true, "inApp": true}
          }
        },
        "requiredDataKeys": ["tool", "config"],
        "isPrimary": false
      }
    ]
  }
}
