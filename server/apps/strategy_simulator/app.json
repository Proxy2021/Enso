            { "name": "Target AlphaRank", "cagr": 18.0, "sharpe": 1.5, "maxDrawdown": -25.0, "turnover": 200, "category": "target" }
          ],
          "notes": "Historical data sourced from published academic research and index providers. ML backtest results are in-sample and subject to overfitting bias."
        },
        "requiredDataKeys": ["tool", "strategies"],
        "isPrimary": false
      },
      {
        "suffix": "risk_calc",
        "description": "Interactive risk budget calculator. Given portfolio size, return target, and max drawdown, computes required Sharpe ratio, volatility budget, position count, transaction costs, and break-even win rate. Use when the user says: 'calculate risk budget', 'risk analysis', 'how much can I lose', 'position sizing'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "portfolioSize": {
              "type": "number",
              "description": "Portfolio size in dollars"
            },
            "returnTarget": {
              "type": "number",
              "description": "Annual return target percentage"
            },
            "maxDrawdown": {
              "type": "number",
              "description": "Maximum acceptable drawdown percentage"
            },
            "turnoverEstimate": {
              "type": "number",
              "description": "Estimated annual turnover percentage (default: 150)"
            },
            "commissionBps": {
              "type": "number",
              "description": "Commission in basis points per trade (default: 5)"
            }
          },
          "required": []
        },
        "sampleParams": { "portfolioSize": 100000, "returnTarget": 18, "maxDrawdown": 25 },
        "sampleData": {
          "tool": "enso_strategy_simulator_risk_calc",
          "inputs": {
            "portfolioSize": 100000,
            "returnTarget": 18,
            "maxDrawdown": 25,
            "turnoverEstimate": 150,
            "commissionBps": 5
          },
          "outputs": {
            "requiredSharpe": 1.44,
            "impliedVolatility": 12.5,
            "suggestedPositions": 25,
            "annualTransactionCosts": 1500,
            "transactionCostPct": 1.5,
            "breakEvenWinRate": 55.2,
            "kellyFraction": 0.18,
            "riskOfRuin": 2.3
          },
          "formulas": {
            "sharpe": "Required Sharpe = Return Target / Implied Volatility",
            "volatility": "Implied Vol = Max Drawdown / (Drawdown Multiplier × √T)",
            "positions": "Min Positions = 1 / (Max Single Weight × Concentration Factor)",
            "costs": "Annual Costs = Portfolio × Turnover × 2 × Commission(bps)/10000",
            "winRate": "Break-even = 0.5 + (Costs / (2 × Portfolio × Return%))"
          }
        },
        "requiredDataKeys": ["tool", "inputs", "outputs"],
        "isPrimary": false
      },
