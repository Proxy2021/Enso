  "spec": {
    "toolFamily": "strategy_simulator",
    "toolPrefix": "enso_strategy_simulator_",
    "description": "Portfolio strategy simulator for exploring construction parameters, risk budgeting, performance benchmarks, development roadmaps, and decision tracking for quantitative trading strategies",
    "signatureId": "strategy_simulator_view",
    "tools": [
      {
        "suffix": "configure",
        "description": "Configure portfolio construction parameters and see computed impact metrics. Adjusts holdings count, rebalance frequency, weighting scheme, concentration limits, and regime buffer. Use when the user says: 'configure strategy', 'set portfolio parameters', 'adjust holdings', 'strategy settings'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "holdings": {
              "type": "number",
              "description": "Number of holdings (10, 20, 30, or 50)"
            },
            "rebalanceFrequency": {
              "type": "string",
              "description": "Rebalance frequency: weekly, monthly, or quarterly"
            },
            "weightingScheme": {
              "type": "string",
              "description": "Weighting scheme: equal_weight, rank_weighted, or volatility_scaled"
            },
            "maxSingleWeight": {
              "type": "number",
              "description": "Maximum single-stock weight percentage (1-10)"
            },
            "maxSectorConcentration": {
              "type": "number",
              "description": "Maximum sector concentration percentage (15-40)"
            },
            "regimeBuffer": {
              "type": "boolean",
              "description": "Enable regime-conditional cash buffer"
            }
          },
          "required": []
        },
        "sampleParams": { "holdings": 30, "rebalanceFrequency": "monthly", "weightingScheme": "equal_weight" },
        "sampleData": {
          "tool": "enso_strategy_simulator_configure",
          "config": {
            "holdings": 30,
            "rebalanceFrequency": "monthly",
            "weightingScheme": "equal_weight",
            "maxSingleWeight": 5,
            "maxSectorConcentration": 25,
            "regimeBuffer": false
          },
          "metrics": {
            "estimatedTurnover": "~140%",
            "diversificationScore": 7.5,
            "concentrationRisk": "Medium",
            "rebalanceCostImpact": "0.35%",
            "effectivePositions": 28.5,
            "herfindahlIndex": 0.035
          },
          "warnings": []
        },
        "requiredDataKeys": ["tool", "config", "metrics"],
        "isPrimary": true
      },
      {
        "suffix": "benchmark",
        "description": "Show historical performance reference table comparing benchmark strategies with CAGR, Sharpe ratio, max drawdown, and turnover data. Use when the user says: 'show benchmarks', 'performance comparison', 'historical returns', 'strategy comparison'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "period": {
              "type": "string",
              "description": "Historical period: 10yr, 20yr, or full (default: 20yr)"
            }
          },
          "required": []
        },
        "sampleParams": {},
