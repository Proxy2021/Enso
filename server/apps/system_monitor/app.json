{
  "version": 1,
  "createdAt": 1742691600000,
  "spec": {
    "toolFamily": "system_monitor",
    "toolPrefix": "enso_system_monitor_",
    "description": "System health dashboard: CPU, memory, disk usage, and running processes",
    "signatureId": "system_monitor_view",
    "tools": [
      {
        "suffix": "overview",
        "description": "Get system overview: CPU usage, memory, uptime, platform info",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_system_monitor_overview",
          "hostname": "my-pc",
          "platform": "Windows_NT 10.0.26200",
          "cpuModel": "AMD Ryzen 9 5900X",
          "cpuCores": 24,
          "cpuUsage": 23,
          "memory": { "total": "32.0 GB", "used": "18.2 GB", "free": "13.8 GB", "usagePercent": 57 },
          "uptime": "5d 3h 22m",
          "nodeVersion": "v22.0.0",
          "loadAverage": [1.2, 1.5, 1.3]
        },
        "requiredDataKeys": ["tool", "hostname", "memory"],
        "isPrimary": true
      },
      {
        "suffix": "processes",
        "description": "List top processes by CPU or memory usage",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sort_by": {
              "type": "string",
              "enum": ["cpu", "memory"],
              "description": "Sort by CPU or memory usage"
            },
            "limit": {
              "type": "number",
              "description": "Max processes to return (default 15)"
            }
          },
          "required": []
        },
        "sampleParams": { "sort_by": "cpu", "limit": 10 },
        "sampleData": {
          "tool": "enso_system_monitor_processes",
          "sortBy": "cpu",
          "count": 3,
          "processes": [
            { "pid": 1234, "name": "node", "cpu": "12.5s", "memory": "150 MB" },
            { "pid": 5678, "name": "chrome", "cpu": "8.3s", "memory": "420 MB" }
          ]
        },
        "requiredDataKeys": ["tool", "processes"],
        "isPrimary": false
      },
      {
        "suffix": "disk_usage",
        "description": "Get disk partition usage statistics",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_system_monitor_disk_usage",
          "count": 2,
          "disks": [
            { "mount": "C:\\", "filesystem": "NTFS", "total": "500.0 GB", "used": "320.0 GB", "free": "180.0 GB", "usagePercent": 64 },
            { "mount": "D:\\", "filesystem": "NTFS", "total": "1.0 TB", "used": "450.0 GB", "free": "550.0 GB", "usagePercent": 45 }
          ]
        },
        "requiredDataKeys": ["tool", "disks"],
        "isPrimary": false
      }
    ]
  }
}
