{
  "version": 1,
  "createdAt": 1710864000000,
  "spec": {
    "toolFamily": "performance_dashboard",
    "toolPrefix": "enso_performance_dashboard_",
    "description": "Interactive KPI performance dashboard with quarterly metrics, trend charts, benchmark comparisons, and AI-generated insights",
    "signatureId": "performance_dashboard_overview",
    "tools": [
      {
        "suffix": "overview",
        "description": "Show a performance dashboard with KPI stat cards, trend charts, data table, and insights for any set of business metrics across time periods",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topic": {
              "type": "string",
              "description": "The business domain or topic for the dashboard (e.g., 'e-commerce', 'SaaS', 'marketing')"
            },
            "metrics": {
              "type": "string",
              "description": "Comma-separated list of metric names to track (e.g., 'Revenue,AOV,Conversion Rate,CAC')"
            },
            "periods": {
              "type": "string",
              "description": "Comma-separated period labels (e.g., 'Q1,Q2,Q3,Q4' or 'Jan,Feb,Mar')"
            }
          },
          "required": []
        },
        "sampleParams": { "topic": "e-commerce", "metrics": "Revenue,AOV,Conversion Rate,CAC", "periods": "Q1,Q2,Q3,Q4" },
        "sampleData": {
          "tool": "enso_performance_dashboard_overview",
          "title": "Quarterly Performance Dashboard",
          "subtitle": "E-Commerce KPIs — FY 2025",
          "industry": "e-commerce",
          "periods": ["Q1", "Q2", "Q3", "Q4"],
          "kpis": [
            { "key": "revenue", "name": "Revenue", "format": "currency", "color": "#3b82f6", "values": [1280000, 1520000, 1745000, 2130000], "benchmark": null, "inverse": false },
            { "key": "aov", "name": "AOV", "format": "dollars", "color": "#8b5cf6", "values": [72, 78, 86, 93], "benchmark": 150, "inverse": false },
            { "key": "conversion", "name": "Conv. Rate", "format": "percent", "color": "#10b981", "values": [2.1, 2.6, 3.4, 2.9], "benchmark": 2.5, "inverse": false },
            { "key": "cac", "name": "CAC", "format": "dollars", "color": "#f59e0b", "values": [42, 31, 22, 35], "benchmark": 76, "inverse": true }
          ],
          "chartData": [
            { "period": "Q1", "revenue": 1280000, "aov": 72, "conversion": 2.1, "cac": 42 },
            { "period": "Q2", "revenue": 1520000, "aov": 78, "conversion": 2.6, "cac": 31 },
            { "period": "Q3", "revenue": 1745000, "aov": 86, "conversion": 3.4, "cac": 22 },
            { "period": "Q4", "revenue": 2130000, "aov": 93, "conversion": 2.9, "cac": 35 }
          ],
          "tableData": [
            { "period": "Q1", "revenue": "$1.28M", "aov": "$72", "conversion": "2.1%", "cac": "$42" },
            { "period": "Q2", "revenue": "$1.52M", "aov": "$78", "conversion": "2.6%", "cac": "$31" },
            { "period": "Q3", "revenue": "$1.75M", "aov": "$86", "conversion": "3.4%", "cac": "$22" },
            { "period": "Q4", "revenue": "$2.13M", "aov": "$93", "conversion": "2.9%", "cac": "$35" }
          ],
          "insights": [
            "Q4 delivered the highest revenue at $2.13M, driven by seasonal holiday demand.",
            "Q3 achieved the best conversion rate at 3.4%, coinciding with the lowest CAC of $22.",
            "AOV grew 29% from Q1 ($72) to Q4 ($93), suggesting successful upselling strategies."
          ]
        },
        "requiredDataKeys": ["tool", "kpis"],
        "isPrimary": true
      },
      {
        "suffix": "detail",
        "description": "Show detailed performance data for a single metric with period-by-period breakdown, bar chart, and change tracking",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric": {
              "type": "string",
              "description": "The metric key to show detail for (e.g., 'revenue', 'aov', 'conversion', 'cac')"
            }
          },
          "required": ["metric"]
        },
        "sampleParams": { "metric": "revenue" },
        "sampleData": {
          "tool": "enso_performance_dashboard_detail",
          "metric": {
            "key": "revenue",
            "name": "Revenue",
            "format": "currency",
