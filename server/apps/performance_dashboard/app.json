            { "name": "AOV", "values": [72, 78, 86, 93] },
            { "name": "Conv. Rate", "values": [2.1, 2.6, 3.4, 2.9] },
            { "name": "CAC", "values": [42, 31, 22, 35] }
          ]
        },
        "requiredDataKeys": ["tool", "metrics", "periods"],
        "isPrimary": false
      },
      {
