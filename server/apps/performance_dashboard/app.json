              { "label": "Q2", "value": 1520000 },
              { "label": "Q3", "value": 1745000 },
              { "label": "Q4", "value": 2130000 }
            ]
          }
        },
        "requiredDataKeys": ["tool", "metric"],
        "isPrimary": false
      },
      {
        "suffix": "compare",
        "description": "Compare multiple metrics on a normalized 0-100 scale to visualize relative trend shapes across time periods",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metricKeys": {
              "type": "string",
              "description": "Comma-separated metric keys to compare (e.g., 'revenue,aov,conversion,cac')"
            }
          },
          "required": []
        },
        "sampleParams": {},
