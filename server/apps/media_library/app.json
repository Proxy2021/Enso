        "suffix": "batch_seed",
        "description": "Batch auto-seed engagement data (ratings, favorites, consumption status) from existing metadata in wiki pages. Converts Amazon stars, TMDB scores, and Metacritic ratings to the 1-10 user rating scale. Actions: preview (dry-run showing what would change), seed (apply changes), status (show current engagement coverage). Use when the user says: 'seed my ratings', 'auto-populate ratings', 'bootstrap engagement data', 'import ratings from metadata'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action: preview (dry run), seed (apply), status (show coverage)"
            },
            "skipExisting": {
              "type": "boolean",
              "description": "Skip entities that already have a user rating (default: true)"
            }
          },
          "required": ["action"]
        },
        "sampleParams": { "action": "preview" },
        "sampleData": {
          "tool": "enso_media_library_batch_seed",
          "action": "preview",
          "totalCandidates": 580,
          "wouldRate": 450,
