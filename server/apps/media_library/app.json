          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query string"
            },
            "mediaType": {
              "type": "string",
              "description": "Limit search to a media type: books, movies, tv, documentaries, games, music, photos"
            },
            "limit": {
              "type": "number",
              "description": "Max results (default: 30)"
            }
          },
          "required": ["query"]
