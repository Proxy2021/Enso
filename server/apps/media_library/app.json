        "suffix": "franchise",
        "description": "Detect, browse, and manage franchise/series groupings across your media library. Groups related entities (books, movies, TV, games) into franchises using title similarity and cross-references. Actions: detect (analyze & group), list (show all franchises), view (detailed franchise), merge (combine franchises or add entity). Use when the user says: 'find franchises', 'group related media', 'show series', 'what franchise is this part of', 'detect franchises'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action: detect (analyze entities, build franchise groups), list (show all franchises), view (detailed franchise), merge (combine franchises or add entity)"
            },
            "franchiseId": {
              "type": "string",
              "description": "Franchise ID (for view, merge target)"
            },
            "entityId": {
              "type": "string",
              "description": "Entity ID — for list: find franchise containing this entity; for merge: add this entity to franchise"
            },
            "sourceFranchiseId": {
              "type": "string",
