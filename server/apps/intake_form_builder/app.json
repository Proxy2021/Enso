        "description": "List all saved patient intake form templates with summary statistics (field count, PHI fields, compliance score). Use when the user says: 'show my forms', 'list intake forms', 'browse form templates', 'open form builder'.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "filter": {
              "type": "string",
              "description": "Filter forms by status: all, draft, published (default: all)"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
