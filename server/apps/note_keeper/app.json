            "title": {
              "type": "string",
              "description": "Note title"
            },
            "body": {
              "type": "string",
              "description": "Note body content"
            },
            "tags": {
              "type": "string",
              "description": "Comma-separated tags"
            }
          },
          "required": ["title", "body"]
        },
        "sampleParams": { "title": "Meeting Notes", "body": "Discussed Q2 goals and roadmap", "tags": "work,meetings" },
