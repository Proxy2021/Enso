{
  "version": 1,
  "createdAt": 1710000000000,
  "spec": {
    "toolFamily": "asset_gallery",
    "toolPrefix": "enso_asset_gallery_",
    "description": "Digital asset management gallery for browsing, organizing, searching, and managing visual assets with status workflows, tagging, and campaign organization",
    "signatureId": "asset_gallery_view",
    "tools": [
      {
        "suffix": "browse",
        "description": "Browse assets in a collection or campaign with filtering and sorting. Shows grid of assets with metadata.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "Collection or folder path to browse"
            },
            "campaign": {
              "type": "string",
              "description": "Filter by campaign name"
            },
            "status": {
              "type": "string",
              "description": "Filter by status: Approved, Draft, In-Use, Archived"
            },
            "format": {
              "type": "string",
              "description": "Filter by format: JPEG, PNG, MP4, GIF"
            },
            "sortBy": {
              "type": "string",
              "description": "Sort field: dateAdded, title, campaign, format (default: dateAdded)"
            },
            "sortDir": {
              "type": "string",
              "description": "Sort direction: asc or desc (default: desc)"
            }
          },
          "required": []
        },
        "sampleParams": {},
        "sampleData": {
          "tool": "enso_asset_gallery_browse",
          "title": "Marketing Assets",
          "path": "All Assets",
          "total": 24,
          "stats": [
            { "label": "Total", "value": 24, "accent": "blue" },
            { "label": "Approved", "value": 12, "accent": "emerald" },
            { "label": "Draft", "value": 6, "accent": "amber" },
            { "label": "In-Use", "value": 4, "accent": "cyan" }
          ],
          "statuses": ["Approved", "Draft", "In-Use", "Archived"],
          "campaigns": ["Summer Launch", "Brand Refresh", "Product Showcase", "Holiday Campaign"],
          "items": [
            {
              "id": "SL01",
              "title": "Summer Launch Hero Banner",
              "campaign": "Summer Launch",
              "format": "JPEG",
              "status": "Approved",
              "dateAdded": "2026-01-15",
              "tags": ["outdoor", "summer", "vibrant"],
              "color": "linear-gradient(135deg, #f59e0b, #ef4444)"
            }
          ]
        },
        "requiredDataKeys": ["tool", "items"],
        "isPrimary": true
      },
      {
        "suffix": "view",
        "description": "View a single asset with full metadata including tags, dimensions, usage rights, campaign, and notes",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Asset ID to view"
            }
          },
          "required": ["id"]
        },
        "sampleParams": { "id": "SL01" },
        "sampleData": {
          "tool": "enso_asset_gallery_view",
          "id": "SL01",
          "title": "Summer Launch Hero Banner",
          "filename": "summer_hero_banner_v2.jpg",
          "campaign": "Summer Launch",
          "tags": ["outdoor", "summer", "vibrant", "beach"],
          "format": "JPEG",
          "width": 1920,
          "height": 1080,
          "status": "Approved",
          "dateAdded": "2026-01-15",
          "usageRights": "Royalty-Free",
          "category": "Hero Image",
          "notes": "Primary hero for summer landing page.",
          "color": "linear-gradient(135deg, #f59e0b, #ef4444)",
          "collectionPath": "All Assets"
        },
        "requiredDataKeys": ["tool", "id", "title"],
        "isPrimary": false
      },
      {
        "suffix": "search",
        "description": "Search assets by keywords matching title, tags, campaign, and notes",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query"
            },
            "path": {
              "type": "string",
              "description": "Collection path to search within"
            }
          },
          "required": ["query"]
        },
        "sampleParams": { "query": "summer hero" },
        "sampleData": {
          "tool": "enso_asset_gallery_search",
          "query": "summer hero",
          "path": "All Assets",
          "total": 2,
          "results": [
            {
              "id": "SL01",
              "title": "Summer Launch Hero Banner",
              "campaign": "Summer Launch",
              "status": "Approved",
              "format": "JPEG",
              "matchReason": "title: summer, hero",
              "color": "linear-gradient(135deg, #f59e0b, #ef4444)"
            }
          ]
        },
        "requiredDataKeys": ["tool", "query", "results"],
        "isPrimary": false
      },
      {
        "suffix": "status",
        "description": "Update the workflow status of one or more assets (Approved, Draft, In-Use, Archived, Rejected)",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Single asset ID"
            },
            "ids": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Multiple asset IDs for bulk status update"
            },
            "status": {
              "type": "string",
              "description": "New status: Approved, Draft, In-Use, Archived, Rejected"
            }
          },
          "required": ["status"]
        },
        "sampleParams": { "id": "SL01", "status": "Approved" },
        "sampleData": {
          "tool": "enso_asset_gallery_status",
          "id": "SL01",
          "title": "Summer Launch Hero Banner",
          "status": "Approved",
          "collectionPath": "All Assets"
        },
        "requiredDataKeys": ["tool", "status"],
        "isPrimary": false
      },
      {
        "suffix": "organize",
        "description": "Organize assets: move to campaign, add/remove tags, create collections, bulk operations",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "description": "Action: move, tag, create_collection, delete"
            },
            "ids": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Asset IDs to operate on"
            },
            "campaign": {
              "type": "string",
              "description": "Target campaign for move action"
            },
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Tags to add/remove"
            },
            "collectionName": {
              "type": "string",
              "description": "Collection name for create_collection action"
            }
          },
          "required": ["action"]
        },
        "sampleParams": { "action": "move", "ids": ["SL01"], "campaign": "Brand Refresh" },
        "sampleData": {
          "tool": "enso_asset_gallery_organize",
          "action": "move",
          "message": "Moved 1 asset to Brand Refresh",
          "path": "All Assets"
        },
        "requiredDataKeys": ["tool", "action", "message"],
        "isPrimary": false
      },
      {
        "suffix": "create",
        "description": "Register a new asset in the gallery with metadata",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "Asset title"
            },
            "campaign": {
              "type": "string",
              "description": "Campaign name"
            },
            "format": {
              "type": "string",
              "description": "File format: JPEG, PNG, MP4, GIF"
            },
            "width": {
              "type": "number",
              "description": "Width in pixels"
            },
            "height": {
              "type": "number",
              "description": "Height in pixels"
            },
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Asset tags"
            },
            "category": {
              "type": "string",
              "description": "Asset category: Hero Image, Social Post, Banner, Video, etc."
            },
            "usageRights": {
              "type": "string",
              "description": "Usage rights: Royalty-Free, Rights-Managed, Internal Only, Unlimited"
            },
            "notes": {
              "type": "string",
              "description": "Notes about the asset"
            }
          },
          "required": ["title"]
        },
        "sampleParams": { "title": "New Campaign Banner", "campaign": "Summer Launch", "format": "JPEG" },
        "sampleData": {
          "tool": "enso_asset_gallery_create",
          "id": "NEW01",
          "title": "New Campaign Banner",
          "campaign": "Summer Launch",
          "format": "JPEG",
          "status": "Draft",
          "dateAdded": "2026-03-19",
          "collectionPath": "All Assets"
        },
        "requiredDataKeys": ["tool", "id", "title"],
        "isPrimary": false
      }
    ]
  }
}
